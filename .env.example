# All variables here are PUBLIC_-prefixed on purpose: this is a static Astro
# site (output: 'static'), so anything read at build time ends up baked into
# public JS regardless of the prefix. See CLAUDE.md — "the web key is friction,
# not an auth boundary" — before adding a variable here that isn't meant to be
# public.

# elenchus-proxy Worker endpoint this site calls.
PUBLIC_ELENCHUS_PROXY_URL=https://elenchus-proxy.example.workers.dev

# Value of the Worker's PROXY_SHARED_SECRET_WEB. Placeholder only — never a
# real key. This does not authenticate the caller; it only distinguishes the
# web surface from the extension surface for rate-limit accounting.
PUBLIC_ELENCHUS_WEB_KEY=replace_with_local_dev_value

# Cloudflare Turnstile site key (site keys are public by design; the paired
# secret key lives only in the Worker's environment, never here).
PUBLIC_TURNSTILE_SITE_KEY=replace_with_turnstile_site_key
