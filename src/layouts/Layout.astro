---
import '../styles/global.css';
import { strings } from '../lib/strings.js';
import { twinFor } from '../lib/twin.js';
import HouseHeader from '../components/HouseHeader.astro';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  /**
   * The page's ENGLISH path, always with its trailing slash ('/', '/analyze/').
   * The French twin is derived from it, because that is the site's actual
   * shape — `/x/` and `/fr/x/` — and deriving it means the two languages
   * cannot disagree about each other's URL, which is the usual way hreflang
   * goes wrong. Omit it and the canonical/hreflang block is skipped entirely
   * rather than emitted wrong.
   */
  path?: string;
  /**
   * True on a page that exists only to be redirected away from (Netlify's
   * forced 301 does that at the edge, so a crawler would only ever see this
   * meta if it somehow reached the origin page directly — belt and braces).
   * Sub-project 2c, Task 3: /analyze and /fr/analyze became this once the
   * front page took over as the analyzer.
   */
  noindex?: boolean;
}

const {
  title = 'Elenchus — reasoning analyzer',
  description = 'Paste any text and get a structured analysis of its logical flaws, reasoning score and strengths.',
  lang = 'en',
  path,
  noindex = false,
} = Astro.props;

const enHref = path ? new URL(path, Astro.site).href : null;
const frHref = path ? new URL(path === '/' ? '/fr/' : `/fr${path}`, Astro.site).href : null;
const canonical = lang === 'fr' ? frHref : enHref;

// The footer's (and HouseHeader's) other-language twin — factored into
// src/lib/twin.js so the header and the footer cannot disagree about it.
// It is a SEPARATE computation from enHref/frHref above: those feed the
// <link rel="alternate"> hreflang tags, which need Astro.site to produce
// absolute URLs at build time; twinFor is a plain function with no Astro
// context, so it carries its own copy of the site origin (see its file
// comment) rather than sharing Astro.site.
const { otherHref, otherLang, otherLabel } = twinFor(lang, path);

// The privacy policy is LINKED, never restated here. The canonical pages live
// in the portfolio hub because they are the only copy a user can reach — the
// extension repo is private — and they are what the Chrome Web Store points
// at. This site's use of Cloudflare Turnstile is disclosed there, scoped to
// the web surface. `scripts/check-privacy-sync.sh` in the elenchus repo fails
// if this link goes missing.
const t = strings[lang] ?? strings.en;
---

<html lang={lang}>
  <head>
    <script is:inline>try{var t=localStorage.getItem('elenchus:theme');if(t==='light'||t==='dark')document.documentElement.classList.add(t)}catch(e){}</script>
    {/* The script above reads any EXPLICIT stored theme and applies its
        class before the stylesheet is even parsed, so a light/dark choice
        never flashes the wrong scheme. 'system' is stored as the absence of
        a class, so it does nothing here — house.css's own
        prefers-color-scheme media query already handles that case with no
        script at all. Must stay the FIRST CHILD of <head>: Astro emits the
        bundled stylesheet's <link> at the end of <head> regardless of where
        the CSS is imported from, so this script's position is what actually
        guarantees it runs first — see test/houseShell.test.js. */}
    <meta charset="utf-8" />
    {/* viewport-fit=cover is what makes env(safe-area-inset-bottom) resolve
        to anything other than 0 — see .tool-nav-bar in global.css, which
        adds that inset on top of its own padding rather than replacing it. */}
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {/* The house contour, tinted teal — see public/favicon.svg's header. The
        .ico is DECLARED rather than left to the browser's automatic
        /favicon.ico probe, so the fallback is a deliberate file and not
        whatever happens to sit at that path. */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    {canonical && <link rel="canonical" href={canonical} />}
    {enHref && <link rel="alternate" hreflang="en" href={enHref} />}
    {frHref && <link rel="alternate" hreflang="fr" href={frHref} />}
    {/* English is x-default: it is the wider audience, and the site's own
        user-facing language per CLAUDE.md. */}
    {enHref && <link rel="alternate" hreflang="x-default" href={enHref} />}
    <title>{title}</title>
  </head>
  <body>
    <HouseHeader lang={lang} path={path} />
    {/* The band slot sits BETWEEN the bar and the column, so a hero is flush
        under the header hairline and bleeds to the viewport edge. Rendered
        inside the column instead, it was boxed at the column's width with the
        page's own top padding above it — the drift the spec measured against
        Doxa. A page with no band (/bookmarklet/, 404) renders nothing here,
        and the column keeps its own 2rem top padding (global.css). */}
    <slot name="band" />
    <main>
      <slot />
    </main>
    <footer>
      <div class="footer-links">
        <a href={t.privacyUrl}>{t.privacyLabel}</a>
        {
          /* The twin page in the other language, from the same derived pair as
             the hreflang tags above — so the link a reader clicks and the link
             a crawler reads can never point at different pages. `hreflang` and
             `lang` are both set: without `lang`, a screen reader announces
             "Français" in the surrounding page's voice. The header shows the
             two-letter code; the footer keeps the full word. */
          otherHref && (
            <>
              <span aria-hidden="true"> · </span>
              <a href={otherHref} hreflang={otherLang} lang={otherLang}>
                {otherLabel}
              </a>
            </>
          )
        }
      </div>
      {/* Divs, not <p>s: the prose underline rule in global.css keys on
          `main p a` / `main li a`, and the footer is chrome — but a <p> here
          would also make "Made with care by William" a paragraph of running
          text, which it is not. */}
      <div class="footer-credit">
        Made with care by <a href="https://william.revah.paris">William</a>
      </div>
    </footer>
  </body>
</html>
