---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
}

const {
  title = 'Elenchus — reasoning analyzer',
  description = 'Paste any text and get a structured analysis of its logical flaws, reasoning score and strengths.',
  lang = 'en',
} = Astro.props;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <slot />
    </main>
    <footer>
      Made with care by <a href="https://william.revah.paris">William</a>
    </footer>
  </body>
</html>
