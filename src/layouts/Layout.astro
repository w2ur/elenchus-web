---
// The shell stylesheet is imported below, from a <style is:global> tag
// INSIDE <head>, rather than from a frontmatter `import` here — a
// frontmatter CSS import is hoisted by Astro's compiler and its emitted
// <link>/<style> output can land anywhere in <head>, which would race the
// inline theme-detection script for first paint. A <style> tag written
// after that script keeps the two in the order they need to run in. See
// houseShell.test.js's "the head applies the stored theme before any
// stylesheet" for the pin (it checks literal source order, which is why
// this comment avoids spelling out the stylesheet's own filename).
import { strings } from '../lib/strings.js';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  /**
   * The page's ENGLISH path, always with its trailing slash ('/', '/analyze/').
   * The French twin is derived from it, because that is the site's actual
   * shape — `/x/` and `/fr/x/` — and deriving it means the two languages
   * cannot disagree about each other's URL, which is the usual way hreflang
   * goes wrong. Omit it and the canonical/hreflang block is skipped entirely
   * rather than emitted wrong.
   */
  path?: string;
}

const {
  title = 'Elenchus — reasoning analyzer',
  description = 'Paste any text and get a structured analysis of its logical flaws, reasoning score and strengths.',
  lang = 'en',
  path,
} = Astro.props;

const enHref = path ? new URL(path, Astro.site).href : null;
const frHref = path ? new URL(path === '/' ? '/fr/' : `/fr${path}`, Astro.site).href : null;
const canonical = lang === 'fr' ? frHref : enHref;

const otherLang = lang === 'fr' ? 'en' : 'fr';
const otherHref = lang === 'fr' ? enHref : frHref;
const otherLabel = (strings[lang] ?? strings.en).otherLangLabel;

// The privacy policy is LINKED, never restated here. The canonical pages live
// in the portfolio hub because they are the only copy a user can reach — the
// extension repo is private — and they are what the Chrome Web Store points
// at. This site's use of Cloudflare Turnstile is disclosed there, scoped to
// the web surface. `scripts/check-privacy-sync.sh` in the elenchus repo fails
// if this link goes missing.
const t = strings[lang] ?? strings.en;
---

<html lang={lang}>
  <head>
    {/* Reads any EXPLICIT stored theme and applies its class before the
        stylesheet below is even requested, so a light/dark choice never
        flashes the wrong scheme. 'system' is stored as the absence of a
        class, so it does nothing here — house.css's own
        prefers-color-scheme media query already handles that case with no
        script at all. Must stay the first thing in <head>: see the import
        comment above and test/houseShell.test.js. */}
    <script is:inline>try{var t=localStorage.getItem('elenchus:theme');if(t==='light'||t==='dark')document.documentElement.classList.add(t)}catch(e){}</script>
    <style is:global>
      @import '../styles/global.css';
    </style>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {/* The house contour, tinted teal — see public/favicon.svg's header. The
        .ico is DECLARED rather than left to the browser's automatic
        /favicon.ico probe, so the fallback is a deliberate file and not
        whatever happens to sit at that path. */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    {canonical && <link rel="canonical" href={canonical} />}
    {enHref && <link rel="alternate" hreflang="en" href={enHref} />}
    {frHref && <link rel="alternate" hreflang="fr" href={frHref} />}
    {/* English is x-default: it is the wider audience, and the site's own
        user-facing language per CLAUDE.md. */}
    {enHref && <link rel="alternate" hreflang="x-default" href={enHref} />}
    <title>{title}</title>
  </head>
  <body>
    <header class="house">
      {/* The only thing on this page that says which house it belongs to.
          The wordmark links out to the chapeau; the tool name is not a link,
          because it names the page you are already on. */}
      <a class="house-mark" href={t.houseUrl}>{t.houseLabel}</a>
      <span class="house-sep" aria-hidden="true">/</span>
      <span class="house-tool">Elenchus</span>
      {/* Right side, for now — Task 4 moves this mount into HouseHeader.astro
          alongside the language switch; the `margin-left: auto` below is this
          header's own layout rule and travels with that move, not a global
          one. */}
      <ThemeToggle lang={lang} />
    </header>
    <main>
      <slot />
    </main>
    <footer>
      Made with care by <a href="https://william.revah.paris">William</a>
      <span aria-hidden="true"> · </span>
      <a href={t.privacyUrl}>{t.privacyLabel}</a>
      {
        /* The twin page in the other language, from the same derived pair as
           the hreflang tags above — so the link a reader clicks and the link
           a crawler reads can never point at different pages. `hreflang` and
           `lang` are both set: without `lang`, a screen reader announces
           "Français" in the surrounding page's voice. */
        otherHref && (
          <>
            <span aria-hidden="true"> · </span>
            <a href={otherHref} hreflang={otherLang} lang={otherLang}>
              {otherLabel}
            </a>
          </>
        )
      }
    </footer>
  </body>
</html>

<style>
  .house :global(.chrome-btn) {
    margin-left: auto;
  }
</style>
