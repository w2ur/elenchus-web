---
// The landing content below the analyzer, shared by / and /fr/ so the two
// languages cannot drift structurally — only the copy (src/lib/pageCopy.js)
// differs.
//
// Sub-project 2c, Task 3 moved the page's h1, intro and "it does not
// fact-check" paragraph into ToolHero.astro — the front page is now the
// analyzer itself, band first, and CLAUDE.md's rule that the fact-check
// claim precede every call to action means it belongs there, above the
// paste box, not further down a page it no longer opens. What is left here
// is the rest of the landing content: the three ways to use the tool, what
// you get back, the free-tier limits and the privacy/house links.
import { landingCopy } from '../lib/pageCopy.js';
import { strings } from '../lib/strings.js';

interface Props {
  lang: 'en' | 'fr';
}

const { lang } = Astro.props;
const C = landingCopy[lang];
const T = strings[lang];

// Same listing URL and per-language `?hl=` form the analyzer and the
// portfolio hub already use for this extension.
const CHROME_WEB_STORE_URL = `https://chromewebstore.google.com/detail/elenchus/bodfmokjnmkkdobfcnfbplnbplgdbfgl?hl=${lang}`;

// The extension card is the only one whose destination is off-site, so it
// is the only one that gets target/rel. Filled here rather than in the copy
// table: a URL with a language parameter is not prose.
const ways = C.ways.map((way) => ({
  ...way,
  href: way.href ?? CHROME_WEB_STORE_URL,
  external: way.href === null,
}));

const HOUSE_URL = 'https://untilt.app/';
---

{/* One wrapper so the print sheet (global.css, @media print) can hide this
    whole section in one rule. Without it, printing a RESULT carried the
    entire landing page below the analysis — ways/get/limits/privacy, three
    CTAs included — because ul/h2/p are all visible-by-default in print;
    only the header/nav/form/Turnstile/footer had ever been targeted. */}
<div id="landing-content">
  <h2 class="eyebrow">{C.waysHeading}</h2>
  <ul class="ways">
    {
      ways.map((way, i) => (
        <li class="way">
          <a
            class="card way-card"
            href={way.href}
            target={way.external ? '_blank' : undefined}
            rel={way.external ? 'noopener noreferrer' : undefined}
          >
            {/* The three icons are ToolNav.astro's own, REPEATED here rather
                than factored into a shared component: test/houseShell.test.js
                counts three <svg in ToolNav.astro's SOURCE (Item 9), so
                moving them out would break that guard. A second guard pins
                every `d=` in this tile equal to ToolNav's, in order, so the
                repetition cannot drift into two different drawings. The order
                is landingCopy.ways' order — paste box, bookmarklet,
                extension — which is the nav's order too. */}
            <span class="way-icon" aria-hidden="true">
              {i === 0 && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="11" cy="11" r="7" />
                  <path d="m20 20-4.3-4.3" />
                </svg>
              )}
              {i === 1 && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M6 4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v16l-6-4-6 4Z" />
                </svg>
              )}
              {i === 2 && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 9h2.5a1.5 1.5 0 0 0 0-3H4V4a1 1 0 0 1 1-1h4v2.5a1.5 1.5 0 0 0 3 0V3h4a1 1 0 0 1 1 1v4h-2.5a1.5 1.5 0 0 0 0 3H17v4a1 1 0 0 1-1 1h-4v-2.5a1.5 1.5 0 0 0-3 0V17H5a1 1 0 0 1-1-1v-4h2.5a1.5 1.5 0 0 0 0-3H4Z" />
                </svg>
              )}
            </span>
            <span class="way-title">{way.name}</span>
            <span class="way-body">{way.body}</span>
            <span class="way-cta">
              {way.cta}
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m9 18 6-6-6-6" />
              </svg>
            </span>
          </a>
        </li>
      ))
    }
  </ul>

  <h2 class="eyebrow">{C.getHeading}</h2>
  <ul>
    {C.getItems.map((item) => <li>{item}</li>)}
  </ul>

  <h2 class="eyebrow">{C.limitsHeading}</h2>
  <p>{C.limitsText}</p>

  <p class="notice">
    {C.privacyText}<a href={T.privacyUrl}>{C.privacyLink}</a>{C.privacyEnd}
  </p>

  <p>
    {C.houseText}<a href={HOUSE_URL}>{C.houseLink}</a>{C.houseEnd}
  </p>
</div>
