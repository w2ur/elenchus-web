---
// A saved Elenchus run, rendered into the static HTML at build time (crawlers
// and no-JS visitors see it; nothing shifts in after load). The sample object
// is a file written by scripts/freeze-sample.mjs — the model's output,
// committed as-is — so its `result` is as attacker-influenced as a live one
// and goes through the same src/lib/render.js analysisView(): enums clamped
// with oneOf(), free text kept as plain strings. Every value below reaches
// the page through Astro's auto-escaping `{}` expressions; never `set:html`
// with model text (test/sampleResult.test.js renders a hostile fixture).
//
// No ids: the frame can sit on the same page as Analyzer.astro, whose result
// panel owns #result-summary, #no-flaws and #strengths-list. The class twins
// here share those rules in global.css.
//
// The frame (.house-sample / .house-sample-label) is house.css's; the bar
// colour is set by global.css's `.house-sample` rule (--sample-bar).
import { oneOf } from '../lib/clamp.js';
import { analysisView, sampleProvenance } from '../lib/render.js';
import { strings } from '../lib/strings.js';

interface Props {
  sample: {
    lang?: unknown;
    date?: unknown;
    servedBy?: unknown;
    promptVersion?: unknown;
    translated?: unknown;
    result?: unknown;
  };
  /**
   * The level of the three section headings. 3 by default (a frame inside a
   * section that already has its own h2); 2 where the frame sits directly
   * under the page's h1, as it does beside the input card on the front page,
   * since an h3 with no h2 above it breaks the heading order (axe
   * heading-order, measured with Lighthouse on / with a sample present).
   */
  headingLevel?: 2 | 3;
}

const { sample, headingLevel = 3 } = Astro.props;
const H = headingLevel === 2 ? 'h2' : 'h3';
const lang = oneOf(sample?.lang, ['en', 'fr'], 'en') as 'en' | 'fr';
const T = strings[lang];
const view = analysisView(sample?.result, T);
const provenance = sampleProvenance(sample, T);
---

<section class="house-sample" lang={lang}>
  <p class="house-sample-label">
    {provenance.label}
    {provenance.translated && <><br />{provenance.translated}</>}
  </p>

  <H class="eyebrow">{T.summaryHeading}</H>
  <div class="card result-summary-card">
    <p class="result-summary">{view.summary}</p>
    <span class={view.scoreClass}>{view.scoreLabel}</span>
    <p class="score-caveat">{T.scoreCaveat}</p>
  </div>

  <H class="eyebrow">{T.flawsHeading}{" "}<span class="count-badge">{view.flawsCount}</span></H>
  {view.flaws.length === 0 ? (
    <p class="no-flaws">{T.noFlaws}</p>
  ) : (
    view.flaws.map((flaw) => (
      <div class="flaw-card">
        <div class="flaw-type">{flaw.type}</div>
        <span class={`flaw-severity ${flaw.severity}`}>{flaw.severityLabel}</span>
        <blockquote class="flaw-quote">&ldquo;{flaw.quote}&rdquo;</blockquote>
        <p class="flaw-explanation">{flaw.explanation}</p>
      </div>
    ))
  )}

  {view.strengths.length > 0 && (
    <>
      <H class="eyebrow">{T.strengthsHeading}</H>
      <ul class="strengths-list">
        {view.strengths.map((s) => <li>{s}</li>)}
      </ul>
    </>
  )}
</section>
