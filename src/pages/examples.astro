---
// Three saved runs in full (src/components/ExamplesPage.astro). The front
// page's "What you get back" cards link here, one anchor per run. Samples
// are read in frontmatter only, this language's files only (samples.js).
import ExamplesPage from '../components/ExamplesPage.astro';
import Layout from '../layouts/Layout.astro';
import { examplesCopy } from '../lib/pageCopy.js';
import { examplesPageSamples } from '../lib/samples.js';

const E = examplesCopy.en;
const { ids, samples } = examplesPageSamples('en');
// Not indexed while it holds no run: the page then only says the runs are
// being prepared, and the nav does not link to it (ToolNav.astro).
const empty = samples.every((s) => s === null);
---

<Layout title={E.title} description={E.description} lang="en" path="/examples/" wide={!empty} noindex={empty}>
  <ExamplesPage lang="en" ids={ids} samples={samples} />
</Layout>
